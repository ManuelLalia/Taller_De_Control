close all
load('Mediciones_dist.mat');
% t = out.tout(520:621);
% t = linspace(0, length(t)*0.02, length(t));

mi = 541;

distancia = out.angulo_imu(mi:620) / 100;
angulo = out.angulo_servo(mi:620);
angulo = deg2rad(angulo);

t = out.tout(1:length(distancia));

k = 9.81 * sin(mean(-angulo));
% k = 9.81 * sin(deg2rad(-7.4));
x0 = distancia(1);

distancia = x0 - distancia;
x0 = distancia(1);

m_b = 0.2;
x = m_b^2 * k * (exp(-t/m_b) - 1) + m_b * k * t + x0;

% A = 1.7;
% B = 0.35;
% C = A*B;
% D = x0;
% 
% x = A * (exp(-t*B) - 1) + C * t + D;

figure();
stairs(t, distancia);
hold on
plot(t,x);

